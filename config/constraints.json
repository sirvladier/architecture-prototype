  "constraints": [
    {"id": "C1", "name": "Независимое развёртывание", "type": "boolean", "property": "independent_deployment", "expected": true, "enabled": false},
    {"id": "C2", "name": "Минимальная интеграционная ёмкость (модель)", "type": "numeric_min", "property": "integration_capacity", "threshold": 3, "enabled": false},
    {"id": "C3", "name": "Максимум эксплуатационных единиц (модель)", "type": "numeric_max", "property": "operating_units", "threshold": 3, "enabled": false},
    {"id": "C4", "name": "Допустимый способ развёртывания (модель)", "type": "categorical", "property": "deployment_mode", "allowed_values": ["single", "distributed"], "enabled": false}
  ]
