    {"property": "operating_units", "name": "Число эксплуатационных единиц (модель)", "type": "numeric"},
    {"property": "deployment_mode", "name": "Способ развёртывания", "type": "categorical", "value_labels": {"single": "Единое развёртывание", "distributed": "Распределённое развёртывание"}}
